# ─── Azure AI Search ────────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-api-key>
AZURE_SEARCH_VALUE_STREAM_INDEX=value-streams
AZURE_SEARCH_HISTORICAL_PPTS_INDEX=historical-idea-cards

# ─── Azure OpenAI / OpenAI ──────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Alternatively, use OpenAI directly
OPENAI_API_KEY=<your-openai-key>
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o

# ─── Local Vector Store (ChromaDB) ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/indexes/chroma
CHROMA_HISTORICAL_COLLECTION=historical_idea_cards
CHROMA_VALUE_STREAM_COLLECTION=value_streams_local

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/value_stream_rag.db

# ─── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# ─── Retrieval Tuning ───────────────────────────────────────────────────────────
TOP_K_VALUE_STREAMS=10
TOP_K_HISTORICAL=20
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.6
HYBRID_SEARCH_ALPHA=0.5

# ─── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
SLIDE_LEVEL_CHUNKING=true
TABLE_AWARE_CHUNKING=true
